<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>HelloWorldA365</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>6d3109d3-6ff5-438e-aa23-cddd3703b4cb</UserSecretsId>
    <NoWarn></NoWarn>
  </PropertyGroup>

    <PropertyGroup>
        <OpenTelemetryVersion>1.15.3</OpenTelemetryVersion>
    </PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Agents.A365.Observability.Runtime" Version="1.0.0" />
		<PackageReference Include="Microsoft.Agents.A365.Observability.Hosting" Version="1.0.0" />
		<PackageReference Include="Microsoft.Agents.A365.Notifications" Version="1.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="ToolingManifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.3.2" />
		<!-- Must track Azure.Core, which Azure.AI.AgentServer.Responses pulls to 1.59.0. Older
		     Azure.Identity duplicates DefaultAzureCredential instead of type-forwarding to
		     Azure.Core, giving CS0433 "exists in both". The Responses sample pairs with 1.21.0. -->
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.6.0" />
		<PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.5" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.7" />
		<PackageReference Include="OpenTelemetry.Exporter.Console" Version="$(OpenTelemetryVersion)" />
		<PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.15.2" />
		<PackageReference Include="OpenTelemetry.Instrumentation.Http" Version="1.15.1" />
		<PackageReference Include="System.Text.Json" Version="10.0.7" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
		<!-- Keep the exact prerelease that the working stack was built and tested against. A wildcard
		     here makes the same source resolve a different SDK as new prereleases are published. -->
		<PackageReference Include="Microsoft.Agents.Authentication.Msal" Version="1.6.109-beta" />
		<PackageReference Include="Microsoft.Agents.Hosting.AspNetCore" Version="1.6.109-beta" />
		<PackageReference Include="Microsoft.Agents.Storage" Version="1.6.109-beta" />
		<PackageReference Include="Microsoft.Agents.Storage.Transcript" Version="1.6.109-beta" />
		<PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.23.0" />
		<!-- Native Entra Agent OBO / Agent User FIC support. Routines identify the child Agent
		     Identity and its paired Agent User; Microsoft.Identity.Web owns all token exchanges. -->
		<PackageReference Include="Microsoft.Identity.Web.AgentIdentities" Version="4.14.2" />
		<PackageReference Include="Microsoft.Identity.Web.TokenCache" Version="4.14.2" />
		<!-- Responses protocol server. Routines can only invoke an agent through the responses or
		     invocations protocol, and this sample ships activity-only, so routines could never
		     target it. Ships lib/net8.0 as well as net10.0, so it resolves fine on our net9.0. -->
		<PackageReference Include="Azure.AI.AgentServer.Responses" Version="1.0.0-beta.6" />
		<PackageReference Include="Microsoft.Bcl.Memory" Version="10.0.7" />
		<PackageReference Include="System.Runtime.Caching" Version="10.0.7" />

	</ItemGroup>
</Project>
