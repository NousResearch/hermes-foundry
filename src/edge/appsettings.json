{
  "Logging": {
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    },
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Agents.Authentication.Msal": "Warning",
      "Microsoft.Identity": "Warning"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "AzureOpenAIEndpoint": "",
  "ModelDeployment": "gpt-5-chat",
  "McpDiscoverySource": "Manifest",
  "AgentConfiguration": {
  },
  "AgentApplication": {
    "StartTypingTimer": false,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "AutoSignin": false,
      "Handlers": {
        "agentic": {
          "Type": "AgenticUserAuthorization",
          "Settings": {
            // Scopes the agentic sign-in requests. Absent in the stock sample; present in
            // adner/Agent365_Notification_Sample, which demonstrably handles email notifications.
            "Scopes": [
              "https://graph.microsoft.com/.default"
            ],
            // WAS "AgentBluePrint" — a connection name that is NOT DEFINED anywhere in this file.
            // The only connection that exists is ServiceConnection, so the agentic auth handler was
            // pointed at nothing. The working notification sample points this at ServiceConnection.
            "AlternateBlueprintConnectionName": "ServiceConnection"
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "IdentityProxyManager",
        // Blueprint Client ID
        "ClientId": "",
        // https://login.microsoftonline.com/{{BOT_TENANT_ID}}
        "AuthorityEndpoint": "https://login.microsoftonline.com/{{BOT_TENANT_ID}}",
        "Scopes": [
          // APX scope.
          "5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default"
        ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "MSALConfiguration": {
    "MSALEnabledLogPII": false
  },
  "A365AgentTracingId": ""
}
